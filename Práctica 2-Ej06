#include <iostream>

using namespace std;

int main() {
    // Variables
    int num1;
    int num2;

    // Entrada
    cout << "Ingrese el primer numero: ";
    cin >> num1;

    cout << "Ingrese el segundo numero: ";
    cin >> num2;

    // Proceso y Salida
    if (num1 > num2) {
        cout << "El numero mayor es: " << num1 << endl;
    } else {
        cout << "El numero mayor es: " << num2 << endl;
    }

    return 0;
}
