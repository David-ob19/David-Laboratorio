#include <iostream>

using namespace std;

int main() {
    int n;
    double suma = 0;

    do {
        cout << "Ingrese un numero entero positivo N: ";
        cin >> n;
    } while (n <= 0);

    for (int i = 1; i <= n; i = i + 1) {
        suma = suma + (1.0 / i);
    }

    cout << "La suma de la serie es: " << suma << endl;

    return 0;
}
