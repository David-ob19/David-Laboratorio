int leerCantidad(int n) {
    int n;
    do {
        cout << "Ingrese la cantidad de estudiantes (1 a " << MAX_ELEMENTOS << "): ";
        cin >> n;
        if (n < 1 || n > MAX_ELEMENTOS) {
            cout << "ERROR" << endl;
        }
    } while (n < 1 || n > MAX_ELEMENTOS);
    return n;
}

void registrarVector(int vec[], int n) {
    cout << "REGISTRO DE VALORES" << endl;
    for (int i = 0; i < n; i++) {
        cout << "Ingrese el valor para la posicion [" << i << "]: ";
        cin >> vec[i];
    }
}

void mostrarVector(const int vec[], int n) {
    for (int i = 0; i < n; i++) {
        cout << vec[i] << "  ";
    }
  
}

float calcularPromedio(const int vec[], int n) {
    int suma = 0;
    for (int i = 0; i < n; i++) {
        suma += vec[i];
    }
    return suma / n;
}

