#include <iostream>

using namespace std;

int main() {
    // Variables
    int nota1, nota2, nota3, promedio;

    // Entrada
    cout << "Ingrese la primera nota: ";
    cin >> nota1;

    cout << "Ingrese la segunda nota: ";
    cin >> nota2;

    cout << "Ingrese la tercera nota: ";
    cin >> nota3;

    // Proceso
    promedio = (nota1 + nota2 + nota3) / 3;

    // Salida
    cout << "El promedio del estudiante es: " << promedio << endl;

    return 0;
}
