Algoritmo Servirseuncafé
	//ENTRADA
	Definir cafepreparado como cadena
	Definir taza como cadena
	Definir azucar como real
	Definir salida como cadena
	
	Escribir "Ingrese el tipo/estado de la  taza"
	Leer taza
	Escribir "Ingrese el estado del cafe"
	Leer cafepreparado
	Escribir "Ingrese la cantidad/tipo de azucar"
	Leer azucar
	// Proceso 
	
	Escribir "Paso 1: Colocar ", taza, " en la superficie de trabajo."
	Escribir "Paso 2: Servir el ", cafepreparado, "dentro de la ", taza, "."
	Escribir "Paso 3 Agregar ", azucar, "a la", taza, "."
	Escribir "paso 4: Mezclar el contenido con una cuchara"  
	
	//Salida 
	
	Escribir "Salida;  ", salida
FinAlgoritmo
