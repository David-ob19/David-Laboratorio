#include <iostream>

using namespace std;

int main() {
    int cantidad;
    double nota;
    double suma = 0;
    double promedio;

    do {
        cout << "Ingrese la cantidad de evaluaciones: ";
        cin >> cantidad;
        if (cantidad <= 0) {
            cout << "Error: la cantidad debe ser mayor a 0." << endl;
        }
    } while (cantidad <= 0);

    for (int i = 1; i <= cantidad; i = i + 1) {
        do {
            cout << "Ingrese la nota de la evaluacion " << i << " (0 a 100): ";
            cin >> nota;
            if (nota < 0 || nota > 100) {
                cout << "Error: la nota debe estar entre 0 y 100." << endl;
            }
        } while (nota < 0 || nota > 100);

        suma = suma + nota;
    }

    promedio = suma / cantidad;

    cout << endl;
    cout << "Promedio obtenido: " << promedio << endl;
    if (promedio >= 51.0) {
        cout << "Estado del estudiante: APROBADO" << endl;
    } else {
        cout << "Estado del estudiante: REPROBADO" << endl;
    }

    return 0;
}
