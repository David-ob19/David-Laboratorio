#include <iostream>

using namespace std;

int main() {
    int dias;
    double monto;
    double total = 0;
    double promedio;
    int diasMayores1000 = 0;

    do {
        cout << "Ingrese la cantidad de dias a evaluar: ";
        cin >> dias;
        if (dias <= 0) {
            cout << "Error: la cantidad de dias debe ser mayor a 0." << endl;
        }
    } while (dias <= 0);

    for (int i = 1; i <= dias; i = i + 1) {
        do {
            cout << "\nIngrese el monto vendido el dia " << i << " (Bs): ";
            cin >> monto;
            if (monto < 0) {
                cout << "Error: el monto no puede ser negativo." << endl;
            }
        } while (monto < 0);

        total = total + monto;

        if (monto > 1000.0) {
            diasMayores1000 = diasMayores1000 + 1;
            if (monto > 2000.0) {
                cout << "Clasificacion del dia " << i << ": Venta excelente" << endl;
            } else {
                cout << "Clasificacion del dia " << i << ": Venta alta" << endl;
            }
        } else {
            if (monto < 500.0) {
                cout << "Clasificacion del dia " << i << ": Venta baja" << endl;
            } else {
                cout << "Clasificacion del dia " << i << ": Venta regular" << endl;
            }
        }
    }

    promedio = total / dias;

    cout << endl;
    cout << "=== RESUMEN GENERAL ===" << endl;
    cout << "Monto total vendido: Bs " << total << endl;
    cout << "Promedio diario: Bs " << promedio << endl;
    cout << "Dias con ventas superiores a Bs 1000: " << diasMayores1000 << endl;

    return 0;
}
