#include <iostream>

using namespace std;

void leerVentas(double ventas[], int n);
void procesarVentas(double ventas[], int n, double &total, double &promedio, int &diasSuperiores);
void mostrarResultados(double total, double promedio, int diasSuperiores);

int main() {
    const int DIAS = 5;
    double ventas[DIAS];
    double total = 0;
    double promedio = 0;
    int diasSuperiores = 0;

    leerVentas(ventas, DIAS);
    procesarVentas(ventas, DIAS, total, promedio, diasSuperiores);
    mostrarResultados(total, promedio, diasSuperiores);

    return 0;
}

void leerVentas(double ventas[], int n) {
    for (int i = 0; i < n; i = i + 1) {
        do {
            cout << "Ingrese la venta del dia " << i + 1 << ": ";
            cin >> ventas[i];
            if (ventas[i] < 0) {
                cout << "Error: la venta no puede ser negativa." << endl;
            }
        } while (ventas[i] < 0);
    }
}

void procesarVentas(double ventas[], int n, double &total, double &promedio, int &diasSuperiores) {
    total = 0;
    diasSuperiores = 0;

    for (int i = 0; i < n; i = i + 1) {
        total = total + ventas[i];
    }

    promedio = total / n;

    for (int i = 0; i < n; i = i + 1) {
        if (ventas[i] > promedio) {
            diasSuperiores = diasSuperiores + 1;
        }
    }
}

void mostrarResultados(double total, double promedio, int diasSuperiores) {
    cout << endl;
    cout << "Total vendido: " << total << endl;
    cout << "Promedio diario: " << promedio << endl;
    cout << "Dias superiores al promedio: " << diasSuperiores << endl;
}
