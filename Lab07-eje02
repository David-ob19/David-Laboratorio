#include <iostream>

using namespace std;

int leerNumero();
void procesarDigitos(int n, int &mayor, int &menor, int &sumaPares);
void mostrarResultados(int mayor, int menor, int sumaPares);

int main() {
    int n;
    int mayor = 0;
    int menor = 9;
    int sumaPares = 0;

    n = leerNumero();
    procesarDigitos(n, mayor, menor, sumaPares);
    mostrarResultados(mayor, menor, sumaPares);

    return 0;
}

int leerNumero() {
    int num;
    do {
        cout << "Ingrese un numero entero positivo N: ";
        cin >> num;
        if (num <= 0) {
            cout << "Error: el numero debe ser mayor a 0." << endl;
        }
    } while (num <= 0);
    return num;
}

void procesarDigitos(int n, int &mayor, int &menor, int &sumaPares) {
    mayor = n % 10;
    menor = n % 10;
    sumaPares = 0;

    while (n > 0) {
        int digito = n % 10;

        if (digito > mayor) {
            mayor = digito;
        }
        if (digito < menor) {
            menor = digito;
        }
        if (digito % 2 == 0) {
            sumaPares = sumaPares + digito;
        }

        n = n / 10;
    }
}

void mostrarResultados(int mayor, int menor, int sumaPares) {
    cout << endl;
    cout << "Digito mayor: " << mayor << endl;
    cout << "Digito menor: " << menor << endl;
    cout << "Suma de digitos pares: " << sumaPares << endl;
}
