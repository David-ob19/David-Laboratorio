#include <iostream>

using namespace std;

int main() {
    // Variables
    int num;

    // Entrada
    cout << "Ingrese un numero entero: ";
    cin >> num;

    // Proceso y Salida
    if (num % 2 == 0) {
        cout << "El numero es par" << endl;
    } else {
        cout << "El numero es impar" << endl;
    }

    return 0;
}
